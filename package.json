{
  "name": "redis-worker",
  "version": "1.0.0",
  "description": "Redis-based job queue with Express API and worker service",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "src/api/server.js",
  "scripts": {
    "api": "node src/api/server.js",
    "worker": "node src/worker/worker.js",
    "api:dev": "nodemon src/api/server.js",
    "worker:dev": "nodemon src/worker/worker.js",
    "api:dev:job:create": "node scripts/create-job.js",
    "api:dev:jobs:list": "node scripts/list-jobs.js",
    "docker:up": "docker-compose up --build",
    "docker:down": "docker-compose down",
    "test": "npm run test:shared && npm run test:api && npm run test:worker",
    "test:watch": "nodemon --exec 'npm test'",
    "test:shared": "node --test src/shared/*.test.js",
    "test:api": "node --test src/api/*.test.js",
    "test:worker": "node --test src/worker/*.test.js"
  },
  "dependencies": {
    "express": "^5.3.0",
    "redis": "^6.3.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
